---
// Tablero de administración de puestos. Acceso solo para el rol 'admin'.
// El plano público (/plano) sigue siendo solo lectura para todos.
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#EE7326" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/brand/favicon-32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@600&display=swap" rel="stylesheet" />
  <title>Tablero de puestos · PROMASA</title>
  <style>
    *{box-sizing:border-box;margin:0}
    :root{--ink:#162019;--muted:#6b7772;--faint:#95a09a;--line:#e5eae2;--line2:#eef2eb;--bg:#eef1ec;--surface:#fff;--green:#1f9c50;--greenbg:#e7f6ec;--green-ink:#14713a;--red:#dc4b43;--redbg:#fbe9e8;--red-ink:#b0332c;--amber:#d98a1f;--amberbg:#fbf0dc;--brand:#EE7326;--brand-d:#d4641b;--blue:#2055A2;--r:12px;--shadow:0 1px 2px #16201908,0 8px 28px #16201910}
    html,body{height:100%}
    body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:linear-gradient(180deg,#eef1ec,#e8ece6 60%,#eaeee7);-webkit-font-smoothing:antialiased}
    .wrap{max-width:1200px;margin:0 auto;padding:0 20px 72px}
    /* top bar */
    header.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0 13px;margin-bottom:20px;border-bottom:1px solid var(--line);background:#eef1eccc;backdrop-filter:blur(10px);flex-wrap:wrap}
    .brand{font-family:'Oswald',sans-serif;font-weight:600;letter-spacing:.5px;font-size:21px;color:var(--brand);display:flex;align-items:center;gap:10px;line-height:1}
    .brand small{display:block;font-family:'Inter';font-size:9.5px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;font-weight:700;margin-top:3px}
    .account{display:flex;align-items:center;gap:9px;font-size:13px;color:var(--muted)}
    .badge-admin{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:5px 12px 5px 10px;font-size:12px;font-weight:600;color:var(--ink)}
    .badge-admin::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--green)}
    .btn{font:inherit;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:9px;padding:9px 14px;font-weight:600;cursor:pointer;font-size:13px;transition:background .15s,border-color .15s,box-shadow .15s,transform .05s;text-decoration:none;display:inline-flex;align-items:center;gap:7px}
    .btn:hover{background:#f6f8f4;border-color:#d7ddd3}
    .btn:active{transform:translateY(1px)}
    .btn:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
    .btn.primary{background:var(--brand);border-color:var(--brand);color:#fff;box-shadow:0 2px 8px #ee732633}
    .btn.primary:hover{background:var(--brand-d);border-color:var(--brand-d)}
    .btn.ghost{background:transparent}
    .btn.sm{padding:6px 11px;font-size:12px;border-radius:8px}
    .btn.green{color:var(--green-ink);border-color:#c3e6ce;background:#f3fbf5}.btn.green:hover{background:var(--greenbg);border-color:#a9dcb9}
    .btn.red{color:var(--red-ink);border-color:#f1cdca;background:#fdf4f3}.btn.red:hover{background:var(--redbg);border-color:#ebbab6}
    .btn:disabled{opacity:.55;cursor:not-allowed;transform:none}
    /* stats */
    .stats{display:flex;gap:14px;flex-wrap:wrap;margin:0 0 10px}
    .stat{flex:1;min-width:150px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:15px 18px;box-shadow:var(--shadow);position:relative;overflow:hidden}
    .stat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:#d4dacf}
    .stat.occ::before{background:var(--red)}.stat.ok::before{background:var(--green)}
    .stat b{font-size:30px;font-weight:800;display:block;font-variant-numeric:tabular-nums;letter-spacing:-.5px;line-height:1.1}
    .stat span{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.7px;font-weight:700;margin-top:3px;display:block}
    .stat.ok b{color:var(--green)}.stat.occ b{color:var(--red)}
    .ratiowrap{display:flex;align-items:center;gap:12px;margin:2px 2px 22px}
    .ratio{flex:1;height:9px;border-radius:6px;background:var(--greenbg);overflow:hidden;box-shadow:inset 0 0 0 1px #0000000a}
    .ratio i{display:block;height:100%;background:linear-gradient(90deg,#e0564e,var(--red));border-radius:6px;transition:width .5s ease}
    .ratio-pct{font-size:12px;font-weight:700;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}
    /* toolbar */
    .toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 14px}
    .search{position:relative;display:flex;align-items:center}
    .search::before{content:"⌕";position:absolute;left:12px;font-size:18px;color:var(--faint);pointer-events:none}
    .toolbar input#q{padding-left:34px}
    .toolbar input,.toolbar select{font:inherit;border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:13px;background:#fff;color:var(--ink);transition:border-color .15s,box-shadow .15s}
    .toolbar input:focus,.toolbar select:focus{outline:0;border-color:var(--brand);box-shadow:0 0 0 3px #ee732622}
    .toolbar input#q{min-width:230px}
    .seg{display:flex;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;box-shadow:var(--shadow)}
    .seg button{border:0;background:transparent;padding:10px 14px;font:inherit;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;transition:background .15s,color .15s;position:relative}
    .seg button+button{border-left:1px solid var(--line2)}
    .seg button:hover{color:var(--ink)}
    .seg button.on{background:var(--brand);color:#fff}
    .count{margin-left:auto;font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
    /* table */
    .tablewrap{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);overflow:auto}
    table{width:100%;border-collapse:collapse;font-size:13px;min-width:720px}
    th,td{text-align:left;padding:12px 16px;border-bottom:1px solid var(--line2);white-space:nowrap}
    th{font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--faint);background:#fbfcfa;position:sticky;top:0;z-index:1;font-weight:700}
    th.num,td.num{text-align:right;font-variant-numeric:tabular-nums}
    tbody tr{transition:background .1s}
    tbody tr:hover{background:#f7faf5}
    tbody tr:last-child td{border-bottom:0}
    td.code{font-weight:700;font-variant-numeric:tabular-nums;color:var(--ink)}
    td.rubro{color:var(--muted)}
    td.ocup{white-space:normal;color:var(--ink);max-width:280px;font-size:12.5px}
    td.ocup small{color:var(--faint)}
    .pill{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;border-radius:20px;padding:4px 11px;white-space:nowrap}
    .pill.disponible{background:var(--greenbg);color:var(--green-ink)}
    .pill.vendido{background:var(--redbg);color:var(--red-ink)}
    .pill.separado{background:var(--amberbg);color:#9a6414}
    .pill.bloqueado{background:#eef1f4;color:#55606b}
    .pill .dot{width:7px;height:7px;border-radius:50%;background:currentColor}
    .rowactions{display:flex;gap:7px;justify-content:flex-end}
    td.actions{text-align:right}
    .empty{padding:48px;text-align:center;color:var(--muted);font-size:14px}
    .more{display:flex;justify-content:center;padding:16px;border-top:1px solid var(--line2)}
    /* login */
    .login{min-height:100dvh;display:grid;place-items:center;padding:24px;background:radial-gradient(1200px 600px at 50% -10%,#fff6ef,transparent),linear-gradient(180deg,#eef1ec,#e6eae3)}
    .card{width:min(392px,100%);background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px 28px;box-shadow:0 20px 60px #16201918}
    .card h1{font-size:20px;margin-bottom:5px;letter-spacing:-.3px}
    .card p{font-size:13px;color:var(--muted);margin-bottom:20px;line-height:1.5}
    .card label{display:block;font-size:12px;font-weight:600;margin:0 0 13px}
    .card input{display:block;width:100%;margin-top:6px;font:inherit;border:1px solid var(--line);border-radius:10px;padding:12px;font-size:14px;transition:border-color .15s,box-shadow .15s}
    .card input:focus{outline:0;border-color:var(--brand);box-shadow:0 0 0 3px #ee732622}
    .err{font-size:12.5px;color:var(--red-ink);background:var(--redbg);border:1px solid #f0c9c6;border-radius:9px;padding:10px 12px;margin:-2px 0 13px;line-height:1.45}
    /* modal */
    .modal-bg{position:fixed;inset:0;background:#0d1611a8;display:grid;place-items:center;padding:20px;z-index:50;animation:fade .15s ease}
    @keyframes fade{from{opacity:0}to{opacity:1}}
    .modal{width:min(470px,100%);background:#fff;border-radius:18px;padding:26px;box-shadow:0 24px 70px #0b140f50;animation:pop .18s ease}
    @keyframes pop{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:none}}
    .modal h2{font-size:18px;margin-bottom:3px;letter-spacing:-.3px}
    .modal .sub{font-size:13px;color:var(--muted);margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--line2)}
    .modal label{display:block;font-size:12px;font-weight:600;margin-bottom:12px}
    .modal input{display:block;width:100%;margin-top:6px;font:inherit;border:1px solid var(--line);border-radius:10px;padding:11px 12px;font-size:14px;transition:border-color .15s,box-shadow .15s}
    .modal input:focus{outline:0;border-color:var(--brand);box-shadow:0 0 0 3px #ee732622}
    .modal .req{color:var(--red)}
    .modal .foot{display:flex;gap:10px;justify-content:flex-end;margin-top:18px;padding-top:16px;border-top:1px solid var(--line2)}
    .view-row{display:flex;justify-content:space-between;gap:16px;font-size:13.5px;padding:9px 0;border-bottom:1px dashed var(--line)}
    .view-row:last-child{border-bottom:0}
    .view-row span{color:var(--muted)}.view-row b{font-weight:600;text-align:right}
    [hidden]{display:none!important}
    .toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#162019;color:#fff;padding:12px 20px;border-radius:11px;font-size:13px;font-weight:500;z-index:60;box-shadow:0 10px 36px #0b140f66;animation:pop .2s ease}
    @media(max-width:640px){.wrap{padding:0 12px 60px}.stat{min-width:calc(50% - 7px)}.account .hide-sm{display:none}}
  </style>
</head>
<body>
  <!-- LOGIN -->
  <div id="login" class="login">
    <form id="login-form" class="card">
      <div class="brand" style="margin-bottom:14px">PROMASA <small>Tablero de puestos</small></div>
      <h1>Acceso administrador</h1>
      <p>Solo el administrador puede marcar ocupado/disponible y ver los datos. El plano público es solo lectura.</p>
      <p id="login-err" class="err" hidden></p>
      <label>Correo<input id="email" type="email" autocomplete="username" required /></label>
      <label>Contraseña<input id="password" type="password" autocomplete="current-password" required /></label>
      <button class="btn primary" type="submit" style="width:100%;margin-top:4px">Entrar</button>
    </form>
  </div>

  <!-- DASHBOARD -->
  <div id="dash" class="wrap" hidden>
    <header class="top">
      <div class="brand">PROMASA <small>Tablero de puestos · Administrador</small></div>
      <div class="account"><span class="badge-admin" id="who">Administrador</span><a class="btn sm ghost hide-sm" href="/plano">Ver plano ↗</a><button id="logout" class="btn sm">Salir</button></div>
    </header>

    <div class="stats">
      <div class="stat"><b id="s-total">—</b><span>Puestos</span></div>
      <div class="stat occ"><b id="s-occ">—</b><span>Ocupados</span></div>
      <div class="stat ok"><b id="s-ok">—</b><span>Disponibles</span></div>
    </div>
    <div class="ratiowrap"><div class="ratio"><i id="ratio-fill" style="width:0%"></i></div><span class="ratio-pct" id="ratio-pct">—</span></div>

    <p id="load-err" class="err" hidden style="margin:0 0 12px"></p>
    <div class="toolbar">
      <span class="search"><input id="q" type="search" placeholder="Buscar código, rubro u ocupante…" /></span>
      <select id="sector"><option value="">Todos los rubros</option></select>
      <div class="seg" id="estado-seg">
        <button data-e="" class="on">Todos</button>
        <button data-e="disponible">Disponibles</button>
        <button data-e="vendido">Ocupados</button>
      </div>
      <span class="count" id="count"></span>
    </div>

    <div class="tablewrap">
      <table>
        <thead><tr><th>Código</th><th>Rubro</th><th class="num">m²</th><th class="num">Precio</th><th>Estado</th><th>Ocupante</th><th></th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
      <div id="empty" class="empty" hidden>Sin resultados.</div>
      <div class="more" id="more" hidden><button class="btn" id="more-btn">Mostrar más</button></div>
    </div>
  </div>

  <!-- MODAL: ocupar con datos -->
  <div id="modal-ocupar" class="modal-bg" hidden>
    <form id="form-ocupar" class="modal">
      <h2>Marcar ocupado</h2>
      <p class="sub" id="ocupar-sub"></p>
      <p id="ocupar-err" class="err" hidden></p>
      <label>Nombre del ocupante <span class="req">*</span><input id="o-nombre" required maxlength="120" /></label>
      <label>Documento (DNI/RUC)<input id="o-doc" maxlength="40" /></label>
      <label>Teléfono<input id="o-tel" maxlength="40" /></label>
      <label>Referencia / observación<input id="o-ref" maxlength="160" /></label>
      <div class="foot"><button type="button" class="btn" id="ocupar-cancel">Cancelar</button><button type="submit" class="btn primary">Marcar ocupado</button></div>
    </form>
  </div>

  <!-- MODAL: ver datos -->
  <div id="modal-ver" class="modal-bg" hidden>
    <div class="modal">
      <h2>Datos del puesto</h2>
      <p class="sub" id="ver-sub"></p>
      <div id="ver-body"></div>
      <div class="foot"><button type="button" class="btn" id="ver-close">Cerrar</button><button type="button" class="btn red" id="ver-liberar">Liberar puesto</button></div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';
    type Puesto = { id:string; codigo:string; sector_id:string; estado:string; area:number|null; precio:number|null; version:number; ocupante:any };
    const $ = (id:string)=>document.getElementById(id)!;
    const money=(n:number|null)=> n==null?'—':new Intl.NumberFormat('es-PE',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
    const esc=(v:any)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
    let puestos:Puesto[]=[]; let sectores=new Map<string,string>(); let shown=100;
    let modalTarget:Puesto|null=null;

    function toast(t:string){ const el=document.createElement('div'); el.className='toast'; el.textContent=t; document.body.appendChild(el); setTimeout(()=>el.remove(),2600); }

    if(!supabase){ $('login-err').textContent='Falta configurar Supabase (variables de entorno).'; $('login-err').hidden=false; }

    async function boot(){
      const { data } = await supabase!.auth.getSession();
      if(data.session){ await afterLogin(); } else { $('login').hidden=false; }
    }
    async function afterLogin(){
      // verificar rol admin
      const uid=(await supabase!.auth.getUser()).data.user?.id;
      const { data:perfil } = await supabase!.from('perfiles').select('rol,nombre').eq('id',uid).single();
      if(!perfil || perfil.rol!=='admin'){
        await supabase!.auth.signOut();
        $('login').hidden=false;
        $('login-err').textContent='Tu cuenta no tiene rol de administrador.'; $('login-err').hidden=false;
        return;
      }
      $('login').hidden=true; $('dash').hidden=false;
      $('who').textContent=(perfil.nombre||'Administrador');
      await loadData();
    }
    async function loadData(){
      const { data:secs } = await supabase!.from('sectores').select('id,nombre').order('orden');
      sectores=new Map((secs||[]).map((s:any)=>[s.id,s.nombre]));
      const sel=$('sector') as HTMLSelectElement;
      sel.innerHTML='<option value="">Todos los rubros</option>'+[...sectores.entries()].map(([id,n])=>`<option value="${esc(id)}">${esc(n)}</option>`).join('');
      puestos=[]; $('load-err').hidden=true;
      // Si la migración (columna 'ocupante') no está aplicada, reintenta sin esa columna
      let cols='id,codigo,sector_id,estado,area,precio,version,ocupante';
      for(let off=0;;off+=1000){
        let { data, error } = await supabase!.from('puestos').select(cols).order('codigo').range(off,off+999);
        if(error && /ocupante/.test(error.message)){
          cols='id,codigo,sector_id,estado,area,precio,version';
          $('load-err').innerHTML='⚠️ Falta aplicar la migración en Supabase (no existe la columma <b>ocupante</b>). Puedes ver los puestos, pero para registrar/ver datos de ocupantes corre <b>20261115_admin_ocupante.sql</b>.';
          $('load-err').hidden=false;
          const retry=await supabase!.from('puestos').select(cols).order('codigo').range(off,off+999);
          data=retry.data; error=retry.error;
        }
        if(error){ $('load-err').textContent='Error al cargar los puestos: '+error.message; $('load-err').hidden=false; break; }
        puestos.push(...(data as any)); if(!data || data.length<1000) break;
      }
      render();
    }
    function filtered(){
      const q=($('q') as HTMLInputElement).value.trim().toLowerCase();
      const sec=($('sector') as HTMLSelectElement).value;
      const est=document.querySelector('#estado-seg button.on')!.getAttribute('data-e')||'';
      return puestos.filter(p=>{
        if(sec && p.sector_id!==sec) return false;
        if(est==='disponible' && p.estado!=='disponible') return false;
        if(est==='vendido' && !(p.estado==='vendido'||p.estado==='bloqueado')) return false;
        if(q){ const occ=p.ocupante?`${p.ocupante.nombre||''} ${p.ocupante.documento||''}`:''; const hay=`${p.codigo} ${sectores.get(p.sector_id)||''} ${occ}`.toLowerCase(); if(!hay.includes(q)) return false; }
        return true;
      });
    }
    function render(){
      const occ=puestos.filter(p=>p.estado==='vendido'||p.estado==='bloqueado').length;
      $('s-total').textContent=String(puestos.length); $('s-occ').textContent=String(occ); $('s-ok').textContent=String(puestos.length-occ);
      const pct=puestos.length?Math.round(occ/puestos.length*100):0;
      ($('ratio-fill') as HTMLElement).style.width=pct+'%';
      $('ratio-pct').textContent=pct+'% ocupado';
      const list=filtered();
      $('count').textContent=`${list.length} de ${puestos.length}`;
      const rows=$('rows'); const slice=list.slice(0,shown);
      rows.innerHTML=slice.map(p=>{
        const ocupadoLike=p.estado==='vendido'||p.estado==='bloqueado';
        const estLabel=p.estado==='vendido'?'Ocupado':p.estado==='disponible'?'Disponible':p.estado==='separado'?'Separado':'Bloqueado';
        const occ=p.ocupante&&p.ocupante.nombre
          ? `${esc(p.ocupante.nombre)}${p.ocupante.documento?` <small>· ${esc(p.ocupante.documento)}</small>`:''}`:'';
        const action = ocupadoLike
          ? `<button class="btn sm" data-ver="${p.id}">Ver / Liberar</button>`
          : `<button class="btn sm green" data-ocupar="${p.id}">Marcar ocupado</button>`;
        return `<tr>
          <td class="code">${esc(p.codigo)}</td>
          <td class="rubro">${esc(sectores.get(p.sector_id)||'')}</td>
          <td class="num">${p.area??'—'}</td>
          <td class="num">${money(p.precio)}</td>
          <td><span class="pill ${p.estado}"><i class="dot"></i>${estLabel}</span></td>
          <td class="ocup">${occ||'<span style="color:var(--faint)">—</span>'}</td>
          <td class="actions"><div class="rowactions">${action}</div></td>
        </tr>`;
      }).join('');
      $('empty').hidden=list.length>0;
      ($('more') as HTMLElement).hidden=list.length<=shown;
    }

    // interacciones
    $('q').addEventListener('input',()=>{shown=100;render();});
    $('sector').addEventListener('change',()=>{shown=100;render();});
    $('estado-seg').addEventListener('click',e=>{const b=(e.target as HTMLElement).closest('button');if(!b)return;document.querySelectorAll('#estado-seg button').forEach(x=>x.classList.remove('on'));b.classList.add('on');shown=100;render();});
    $('more-btn').addEventListener('click',()=>{shown+=200;render();});
    $('rows').addEventListener('click',e=>{
      const t=e.target as HTMLElement;
      const idO=t.closest('[data-ocupar]')?.getAttribute('data-ocupar');
      const idV=t.closest('[data-ver]')?.getAttribute('data-ver');
      if(idO) openOcupar(puestos.find(p=>p.id===idO)!);
      if(idV) openVer(puestos.find(p=>p.id===idV)!);
    });

    function openOcupar(p:Puesto){
      modalTarget=p;
      $('ocupar-sub').textContent=`${p.codigo} · ${sectores.get(p.sector_id)||''} · ${money(p.precio)}`;
      (['o-nombre','o-doc','o-tel','o-ref'] as const).forEach(id=>($(id) as HTMLInputElement).value='');
      $('ocupar-err').hidden=true;
      ($('modal-ocupar') as HTMLElement).hidden=false; ($('o-nombre') as HTMLInputElement).focus();
    }
    $('ocupar-cancel').addEventListener('click',()=>($('modal-ocupar') as HTMLElement).hidden=true);
    $('form-ocupar').addEventListener('submit',async e=>{
      e.preventDefault(); if(!modalTarget) return;
      const ocupante={ nombre:($('o-nombre') as HTMLInputElement).value.trim(), documento:($('o-doc') as HTMLInputElement).value.trim(), telefono:($('o-tel') as HTMLInputElement).value.trim(), referencia:($('o-ref') as HTMLInputElement).value.trim(), fecha:new Date().toISOString() };
      if(!ocupante.nombre){ $('ocupar-err').textContent='El nombre es obligatorio.'; $('ocupar-err').hidden=false; return; }
      const btn=($('form-ocupar').querySelector('button[type=submit]') as HTMLButtonElement); btn.disabled=true;
      const { data, error } = await supabase!.rpc('admin_ocupar',{ p_id:modalTarget.id, p_version:modalTarget.version, p_ocupante:ocupante });
      btn.disabled=false;
      if(error){ $('ocupar-err').textContent=error.message; $('ocupar-err').hidden=false; return; }
      const up=Array.isArray(data)?data[0]:data;
      if(!up){ $('ocupar-err').textContent='No se pudo ocupar (verifica que seas administrador, el nombre, o recarga la página).'; $('ocupar-err').hidden=false; return; }
      const i=puestos.findIndex(p=>p.id===up.id); if(i>=0) puestos[i]={...puestos[i],...up};
      ($('modal-ocupar') as HTMLElement).hidden=true; render(); toast(`${up.codigo} marcado como ocupado`);
    });

    function openVer(p:Puesto){
      modalTarget=p; const o=p.ocupante||{};
      $('ver-sub').textContent=`${p.codigo} · ${sectores.get(p.sector_id)||''} · ${money(p.precio)}`;
      const rows=[['Nombre',o.nombre],['Documento',o.documento],['Teléfono',o.telefono],['Referencia',o.referencia],['Registrado',o.fecha?new Date(o.fecha).toLocaleDateString('es-PE'):'']];
      $('ver-body').innerHTML=rows.filter(r=>r[1]).map(r=>`<div class="view-row"><span>${r[0]}</span><b>${esc(r[1])}</b></div>`).join('')||'<p class="sub">Sin datos de ocupante registrados.</p>';
      ($('modal-ver') as HTMLElement).hidden=false;
    }
    $('ver-close').addEventListener('click',()=>($('modal-ver') as HTMLElement).hidden=true);
    $('ver-liberar').addEventListener('click',async()=>{
      if(!modalTarget) return;
      if(!confirm(`¿Liberar el puesto ${modalTarget.codigo}? Se borrarán los datos del ocupante.`)) return;
      const { data, error } = await supabase!.rpc('admin_liberar',{ p_id:modalTarget.id, p_version:modalTarget.version });
      if(error){ toast('Error: '+error.message); return; }
      const up=Array.isArray(data)?data[0]:data;
      if(!up){ toast('No se pudo liberar (recarga la página e intenta de nuevo).'); return; }
      const i=puestos.findIndex(p=>p.id===up.id); if(i>=0) puestos[i]={...puestos[i],...up,ocupante:null};
      ($('modal-ver') as HTMLElement).hidden=true; render(); toast(`${up.codigo} liberado`);
    });

    // login
    $('login-form').addEventListener('submit',async e=>{
      e.preventDefault();
      const email=($('email') as HTMLInputElement).value.trim(); const password=($('password') as HTMLInputElement).value;
      const btn=($('login-form').querySelector('button[type=submit]') as HTMLButtonElement); btn.disabled=true; $('login-err').hidden=true;
      const { error } = await supabase!.auth.signInWithPassword({ email, password });
      btn.disabled=false;
      if(error){ $('login-err').textContent='No se pudo iniciar sesión. Revisa correo y contraseña.'; $('login-err').hidden=false; return; }
      await afterLogin();
    });
    $('logout').addEventListener('click',async()=>{ await supabase!.auth.signOut(); location.reload(); });

    if(supabase) boot();
  </script>
</body>
</html>
