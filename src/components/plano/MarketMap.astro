---
import '../../styles/market-map.css';
import BrandLogo from '../BrandLogo.astro';
interface Props { admin?: boolean }
const { admin = false } = Astro.props;
---
<main class="market-map" id="market-app" data-admin={admin ? 'true' : 'false'}>
  <header class="market-header">
    <BrandLogo />
    <div class="market-counts"><span><i class="dot free"></i><b id="count-free">—</b> disponibles</span><span><i class="dot occupied"></i><b id="count-occupied">—</b> ocupados</span><span class="optional-count"><b id="count-total">1028</b> puestos</span></div>
    <span id="map-connection" role="status">Cargando datos…</span>
    {admin && <div class="account-badge" id="account-badge" hidden><span id="account-name"></span><button id="account-logout" type="button">Salir</button></div>}
    {admin && <button id="admin-login-trigger" class="admin-login-trigger" type="button" hidden>Acceso administrador</button>}
  </header>
  <div class="market-toolbar">
    <label class="map-search" hidden><span>⌕</span><input id="map-search" type="search" placeholder="Buscar puesto: A-1, V-21…" aria-label="Buscar puesto por código" /><button id="search-go" aria-label="Buscar puesto">↵</button></label>
    <select id="map-sector" aria-label="Ir a un sector"><option value="">Todos los sectores</option></select>
    <div class="status-filters" aria-label="Filtrar disponibilidad"><button data-state="" aria-pressed="true">Todos</button><button data-state="disponible" aria-pressed="false">Disponibles</button><button data-state="ocupado" aria-pressed="false">Ocupados</button></div>
    <a class="cards-toggle" href="/recursos/">Documentos comerciales ↗</a>
    <button class="map-reset" id="reset-map">Ver todo ↗</button>
  </div>
  <div id="map-message" role="status" hidden></div>
  <section class="market-canvas" aria-label="Plano interactivo con disponibilidad de puestos">
    <svg id="market-svg" viewBox="0 0 3370 1871" tabindex="0" role="group" aria-label="Plano del mercado. Verde disponible, rojo ocupado. Usa la rueda para ampliar y arrastra para moverte.">
      <defs><pattern id="market-blocked" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="5" height="5" fill="#334155"/><rect width="2" height="5" fill="#94a3b8"/></pattern></defs>
      <image class="market-base" href="/promarsa/plano-2026.webp" x="0" y="0" width="3370" height="1871" preserveAspectRatio="none" />
      <g id="market-stalls"></g>
      <g id="map-rubros" aria-hidden="true"><text class="map-rubro" x="1342.6" y="527.3">PAPA</text><text class="map-rubro" x="383.3" y="325.0">CARNE</text><text class="map-rubro" x="485.3" y="527.0">CARNE</text><text class="map-rubro" x="1193.4" y="742.9">COMIDAS</text><text class="map-rubro" x="469.1" y="258.3">BANCOS</text><text class="map-rubro" x="977.0" y="259.6">TELEFONIA</text><text class="map-rubro" x="1329.6" y="259.9">FARMACIA</text><text class="map-rubro" x="1636.1" y="259.6">FARMACIA</text><text class="map-rubro" x="518.2" y="1355.7">MASCOTAS</text><text class="map-rubro" x="771.1" y="1355.8">PELUQUERÍA</text><text class="map-rubro" x="1609.5" y="1355.8">S. TÉCNICO</text><text class="map-rubro" x="1786.6" y="1355.9">LICORERÍA</text><text class="map-rubro" x="1989.0" y="1355.9">PAPELERÍA</text><text class="map-rubro" x="2165.1" y="1355.9">TECNOLOGÍA</text><text class="map-rubro" x="839.1" y="325.3">POLLO</text><text class="map-rubro" x="1294.8" y="961.4">MENESTRAS</text><text class="map-rubro" x="1548.0" y="961.4">F. SECOS</text><text class="map-rubro" x="1598.0" y="744.6">CHIFA</text><text class="map-rubro" x="1749.9" y="741.9">GRANOS</text><text class="map-rubro" x="1901.5" y="744.6">CHOCLO</text><text class="map-rubro" x="2003.4" y="961.4">FRUTAS</text><text class="map-rubro" x="2003.2" y="1163.9">FRUTAS</text><text class="map-rubro" x="331.8" y="527.8">PESCADO</text><text class="map-rubro" x="433.4" y="743.8">PLÁSTICOS</text><text class="map-rubro" x="587.5" y="961.8">PLÁSTICOS</text><text class="map-rubro" x="739.1" y="527.8">LÁCTEOS</text><text class="map-rubro" x="1042.6" y="527.8">CEBOLLA</text><text class="map-rubro" x="1295.6" y="1163.9">GOLOSINAS</text><text class="map-rubro" x="1396.8" y="1163.9">ESPECIERÍAS</text><text class="map-rubro" x="1648.8" y="1163.9">ABARROTES</text><text class="map-rubro" x="1750.9" y="961.6">ABARROTES</text><text class="map-rubro" x="384.4" y="960.5">ROPA</text><text class="map-rubro" x="789.1" y="744.7">FLORES</text><text class="map-rubro" x="485.4" y="1163.9">COSTURA</text><text class="map-rubro" x="688.7" y="961.8">CALZADO</text><text class="map-rubro" x="789.9" y="961.8">BAZAR</text><text class="map-rubro" x="941.7" y="961.8">JUGUERÍA</text><text class="map-rubro" x="1093.4" y="961.8">NATURALES</text><text class="map-rubro" x="1091.4" y="1163.3">NATURALES</text><text class="map-rubro" x="1295.8" y="325.7">YUCA</text><text class="map-rubro" x="1397.0" y="325.7">PAPA</text><text class="map-rubro" x="1193.3" y="527.7">PAPA</text><text class="map-rubro" x="1498.1" y="325.5">LIMONES</text><text class="map-rubro" x="1496.1" y="527.3">LIMONES</text><text class="map-rubro" x="1599.3" y="325.7">ZAPALLOS</text><text class="map-rubro" x="1597.3" y="527.3">ZAPALLOS</text><text class="map-rubro" x="1700.5" y="325.7">TOMATES</text><text class="map-rubro" x="1698.5" y="527.3">TOMATES</text><text class="map-rubro" x="2104.8" y="325.3">VERDURAS</text><text class="map-rubro" x="2103.4" y="527.3">VERDURAS</text><text class="map-rubro" x="2255.6" y="744.6">VERDURAS</text><text class="map-rubro" x="585.5" y="1163.3">JOYERÍA</text><text class="map-rubro" x="686.7" y="1163.3">MALETAS</text><text class="map-rubro" x="816.0" y="1163.3">FERRETERÍA</text><text class="map-rubro" x="962.1" y="1163.3">JUGUETERÍA</text><text class="map-rubro" x="1863.5" y="259.4">CONVENIENCIA</text><text class="map-rubro" x="1021.5" y="1355.5">CUIDADO</text><text class="map-rubro" x="1198.2" y="1355.5">COSMÉTICOS</text><text class="map-rubro" x="1350.0" y="1355.5">LIBRERÍA</text><text class="map-rubro" x="2115.8" y="259.5">APUESTAS</text><text class="map-rubro" x="2343.4" y="259.5">LIBRES</text><text class="map-avenida" x="150" y="810" transform="rotate(-90 150 810)">PANAMERICANA NORTE</text></g>
    </svg>
    <div class="map-guide">SECTORES Y DISPONIBILIDAD<span>Acerca el plano y toca un puesto</span></div>
    <div class="map-zoom"><button id="market-plus" aria-label="Acercar">+</button><button id="market-minus" aria-label="Alejar">−</button><button id="market-fit" aria-label="Ajustar plano">⛶</button></div>
    <div class="map-legend"><span><i class="dot free"></i>Disponible</span><span><i class="dot occupied"></i>Ocupado / vendido</span><span><i class="dot reserved"></i>Separado</span><span><i class="dot blocked"></i>Bloqueado</span></div>
    <section id="map-detail" class="map-detail" aria-label="Detalle del puesto" hidden>
      <button id="close-map-detail" aria-label="Cerrar detalle">×</button>
      <header class="detail-head">
        <div class="detail-id">
          <small id="detail-rubro"></small>
          <h1 id="detail-code"></h1>
          <p id="detail-tipo" class="detail-tipo"></p>
        </div>
        <div class="detail-badges">
          <span id="detail-ubic" class="detail-badge ubic" hidden></span>
          <span id="detail-status" class="detail-badge"></span>
        </div>
      </header>
      <div class="detail-price"><small>PRECIO · IGV INCLUIDO</small><strong id="detail-price"></strong></div>
      <div id="detail-finance"></div>
      {admin && <div class="detail-actions" id="detail-actions"></div>}
    </section>
    <div id="map-loading" class="map-loading">Cargando disponibilidad de los puestos…</div>
    {admin && (
      <section id="login-panel" class="login-panel" aria-label="Iniciar sesión" hidden>
        <form id="login-form" class="login-form">
          <h1>Acceso administrador</h1>
          <p>Separar y liberar puestos no necesita cuenta. Esta sesión es solo para vender, bloquear/desbloquear y mover de sector.</p>
          <label>Correo<input id="login-email" type="email" autocomplete="username" required /></label>
          <label>Contraseña<input id="login-password" type="password" autocomplete="current-password" required /></label>
          <p id="login-error" class="login-error" hidden></p>
          <button type="submit">Entrar</button>
          <button type="button" id="login-cancel" class="login-cancel">Cancelar</button>
        </form>
      </section>
    )}
  </section>
  <footer class="market-footer"><span>Arrastra para recorrer · Rueda o dos dedos para ampliar</span><span id="visible-map-count">1028 puestos en el plano</span><a href="/promarsa/plano-original.pdf" target="_blank" rel="noopener">Plano original ↗</a></footer>
</main>
<script>
  import { startMarketMap } from '../../lib/plano/market-map';
  const admin=document.getElementById('market-app')?.dataset.admin==='true';
  startMarketMap({admin}).catch(error=>{
    const message=document.getElementById('map-message')!;
    message.hidden=false;message.textContent=error instanceof Error?error.message:'No se pudo cargar la disponibilidad.';
    const loading=document.getElementById('map-loading');
    if(loading) loading.hidden=true;
  });
</script>
