---
interface Props {
  size?: 'sm' | 'md';
  href?: string;
  className?: string;
}
const { size = 'md', href = '/', className = '' } = Astro.props;
// Full brand lockup (roof + "mercado mayorista Naranjal PROMASA"), rendered at 3x.
// Intrinsic PNG size: 1218 x 294 (ratio ~4.14:1).
const heights = { md: 46, sm: 30 };
const height = heights[size];
const width = Math.round((height * 1218) / 294);
---
<a
  class:list={['brand-logo', `brand-logo--${size}`, className]}
  href={href}
  aria-label="Mercado Mayorista Naranjal · PROMASA"
>
  <img
    class="brand-logo__img"
    src="/brand/logo-horizontal.png"
    alt="Mercado Mayorista Naranjal · PROMASA"
    width={width}
    height={height}
    decoding="async"
  />
</a>
<style>
  .brand-logo { display: inline-flex; align-items: center; text-decoration: none; }
  .brand-logo__img { display: block; width: auto; height: 46px; }
  .brand-logo--sm .brand-logo__img { height: 30px; }
  @media (max-width: 850px) {
    .brand-logo--md .brand-logo__img { height: 36px; }
  }
</style>
