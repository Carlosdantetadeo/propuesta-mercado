    "astro": "^4.16.0",
    "tailwindcss": "^3.4.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
